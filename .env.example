# ==============================================================================
# PhishGuard AI / Sentinel AI Configuration
# Copy this file to .env and provide your API keys for enhanced threat intelligence.
# All external threat intelligence services are OPTIONAL. The platform functions
# completely offline with local CNN, ML, rule heuristics, and DNS/TLS checks.
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
DEBUG=True

# Google Safe Browsing API v4
# Get a key at: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_KEY=

# VirusTotal API v3
# Get a free key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# PhishTank API Key (Optional)
# Get a key at: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=

# Request Timeouts & Limits
NETWORK_TIMEOUT_SECONDS=4
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=524288

# Storage Configuration
DATABASE_PATH=data/scans.db
